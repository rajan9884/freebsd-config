// ──────────────────────────────────────────────
//   Waybar Configuration — Noro Theme (Exact Match)
// ──────────────────────────────────────────────
{
    "layer": "top",
    "position": "top",
    "height": 45,
    "spacing": 0,
    "margin-top": 0,
    "margin-left": 15,
    "margin-right": 15,
    "modules-left": [
        "custom/launcher",
        "custom/record",
        "custom/voxtype",
        "clock",
        "custom/user"
    ],
    "modules-center": [
        "sway/workspaces",
        "backlight",
        "pulseaudio",
        "custom/group"
    ],
    "modules-right": [
        "tray",
        "custom/notifications",
        "custom/clipboard",
        "custom/power-profile",
        "battery",
        "custom/wifi",
        "bluetooth",
        "custom/power"
    ],
    "custom/launcher": {
        // FreeBSD daemon logo  (was the Void logo on Linux)
        "format": "",
        "on-click": "rofi -show drun",
        "tooltip": false
    },
    "custom/record": {
        "exec": "~/.config/waybar/scripts/recorder.sh",
        "return-type": "json",
        "interval": 2,
        "on-click": "~/.config/waybar/scripts/recorder.sh toggle"
    },
    "custom/voxtype": {
        "exec": "~/.config/waybar/scripts/voxtype.sh",
        "return-type": "json",
        "interval": 2,
        "on-click": "voxtype record stop"
    },
    "tray": {
        "icon-size": 18,
        "spacing": 8,
        "show-passive-items": true
    },
    "clock": {
        "format": "{:%H:%M}",
        "tooltip": false
    },
    "custom/user": {
        "exec": "whoami",
        "format": "{}",
        "interval": "once",
        "tooltip": false
    },
    // ── Workspaces ────────────────────────────────
    "sway/workspaces": {
        "format": "{icon}",
        "on-click": "activate",
"format-icons": {
        "1": "󰖟",
        "2": "󰍍",
        "3": "󰉋",
        "4": "󰨞",
        "5": "5",
        "6": "6",
        "7": "7",
        "8": "8",
        "9": "9",
        "10": "10"
    },
        "persistent-workspaces": {
            "1": ["eDP-1"],
            "2": ["eDP-1"],
            "3": ["eDP-1"],
            "4": ["eDP-1"]
        }
    },
    "backlight": {
        // FreeBSD backlight node varies by driver (acpi_video0,
        // intel_backlight, …): list with `brightnessctl -l` and adjust.
        "device": "intel_backlight",
        "format": "{icon} {percent}%",
        "format-icons": [
            "󰃞",
            "󰃟",
            "󰃠"
        ],
        "on-scroll-up": "brightnessctl set 5%+ >/dev/null",
        "on-scroll-down": "brightnessctl set 5%- >/dev/null",
        "tooltip": false
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰖁 Muted",
        "format-bluetooth": "{icon} {volume}%",
        "format-bluetooth-muted": "󰖁 Muted",
        "format-icons": {
            "default": [
                "󰕿",
                "󰖀",
                "󰕾"
            ]
        },
        "scroll-step": 5,
        "on-click": "foot --app-id=pulsemixer -e pulsemixer",
        "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "tooltip": false
    },
    "battery": {
        // FreeBSD reports one system battery (hw.acpi.battery.life):
        // BAT0 is the portable pick; there is no ADP0 adapter node here.
        "bat": "BAT0",
        "format": "{capacity}% {icon}",
        "format-charging": "{capacity}% 󱐋",
        "format-plugged": "{capacity}% 󱐋",
        "format-icons": [
            "󰂎",
            "󰁺",
            "󰁻",
            "󰁼",
            "󰁽",
            "󰁾",
            "󰁿",
            "󰂀",
            "󰂁",
            "󰂂",
            "󰁹"
        ],
        "tooltip": false,
        "interval": 30
    },
    "bluetooth": {
        "format": "󰂯",
        "format-disabled": "󰂲",
        "format-off": "󰂲",
        "format-on": "󰂯",
        "format-connected": "󰂱",
        "on-click": "~/.config/waybar/scripts/bluetooth-menu.sh",
        "on-click-right": "~/.config/waybar/scripts/bluetooth-menu.sh",
        "tooltip": true,
        "tooltip-format": "{status}"
    },
    "custom/power-profile": {
        "exec": "~/.config/waybar/scripts/power-profile.sh",
        "return-type": "text",
        "interval": 5,
        "on-click": "~/.local/bin/power-profiles menu",
        "tooltip": false
    },
    "custom/group": {
        "exec": "~/.config/waybar/scripts/group-indicator.sh",
        "return-type": "json",
        "interval": 2,
        "tooltip": true
    },
    "custom/clipboard": {
        "format": "",
        "on-click": "~/.local/bin/menu-clipboard",
        "tooltip": false
    },
    "custom/wifi": {
        "exec": "~/.config/waybar/scripts/wifi-status.sh",
        "return-type": "json",
        "interval": 5,
        "on-click": "~/.config/waybar/scripts/wifi-menu.sh",
        "signal": 14,
        "tooltip": true
    },
    "custom/notifications": {
        "exec": "~/.config/waybar/scripts/notifications.sh",
        "return-type": "json",
        "interval": 5,
        "signal": 15,
        "on-click": "~/.config/sway/scripts/mako-dnd.sh toggle",
        "on-click-right": "makoctl dismiss -a",
        "tooltip": true
    },
    "custom/power": {
        "format": "⏻",
        "on-click": "~/.config/waybar/scripts/power-menu.sh",
        "tooltip": false
    }
}
