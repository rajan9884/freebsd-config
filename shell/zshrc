# ~/.zshrc — freebsd-config (FreeBSD 15.1 desktop).
#
# Guarded tool inits: a missing tool is skipped silently, so the shell always
# starts clean even mid-install (nothing here may error under `set -e`).
# Everything below matches the desktop's other shells.

# ── Aliases (FreeBSD: ls is BSD ls — colour comes from -G + CLICOLOR) ──
case "$(uname -s)" in
    FreeBSD|Darwin|*BSD) alias ls='ls -G' ;;
    *) alias ls='ls --color=auto' ;;
esac
alias grep='grep --color=auto'
alias ff="fzf --preview 'bat --color=always {}'"
alias ll='ls -lt'
alias ..='cd ../'
# FreeBSD service helper (runit's vsv does not exist here).
alias svc='sudo service'
# Dual-GitHub helpers: git-work / git-personal / git-whoami
[ -f "$HOME/.config/zsh/git-accounts.sh" ] && source "$HOME/.config/zsh/git-accounts.sh"

# ── LS colours + completion colours ──
# Palette codes (0-15) not 256-index: they follow the matugen-themed
# terminal palette (foot maps color4=primary, color6=tertiary_container).
# BSD ls reads LSCOLORS; GNU ls reads LS_COLORS — export both.
export CLICOLOR=1
export LSCOLORS="exfxcxdxbxegedabagacad"
export LS_COLORS="di=01;34:ln=01;36:mh=00:pi=40;33:so=01;35:do=01;35:bd=40;33;01:cd=40;33;01:or=40;31;01:mi=00:su=37;41:sg=30;43:ca=00:tw=30;42:ow=34;42:st=37;44:ex=01;32"
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"

# ── Prompt (starship + matugen palette) ──
# ~/.config/starship.toml is generated by matugen on every wallpaper switch
# (templates/starship.toml → truecolor hex palette), so the prompt follows
# the desktop theme in every terminal.
# bash inits starship too (see shell/bashrc).
if command -v starship >/dev/null 2>&1; then eval "$(starship init zsh)"; fi




# ── Command history ──
HISTFILE="$HOME/.zsh_history"
HISTSIZE=100000
SAVEHIST=100000
setopt EXTENDED_HISTORY
setopt SHARE_HISTORY
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_FIND_NO_DUPS
setopt HIST_SAVE_NO_DUPS

# ── Autosuggestions (up-arrow cycles suggestions) ──
# Ports live under /usr/local/share on FreeBSD, /usr/share on Linux.
if [ -f /usr/local/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh ]; then
    source /usr/local/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
elif [ -f /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh ]; then
    source /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
fi
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=#777777'

# ── Tab completion (zsh-completions + compinit) ──
# compinit's freshness check stats every fpath dir (~600ms); -C reuses the
# dump (~30ms). Re-dump at most once a day so new completions still register.
for _fpath in /usr/local/share/zsh/site-functions /usr/share/zsh/site-functions; do
    [ -d "$_fpath" ] && fpath=("$_fpath" $fpath)
done
unset _fpath
autoload -Uz compinit
if [[ -n ${ZDOTDIR:-$HOME}/.zcompdump(#qN.mh+24) ]]; then compinit; else compinit -C; fi
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'
zstyle ':completion:*' verbose true

# ── Syntax highlighting (MUST be LAST plugin) ──
if [ -f /usr/local/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]; then
    source /usr/local/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
elif [ -f /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]; then
    source /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
fi

# ── Editor ──
export EDITOR="nvim" VISUAL="nvim"
export FZF_DEFAULT_OPTS="--height 90% --reverse --border"

# ── Speed tools (zoxide/fzf/yazi/atuin/direnv) ──
if command -v zoxide >/dev/null 2>&1; then eval "$(zoxide init zsh --cmd z)"; fi
# fzf ≥0.48 ships its own integration; fall back to the ports data files.
if command -v fzf >/dev/null 2>&1 && fzf --zsh >/dev/null 2>&1; then
    eval "$(fzf --zsh)"
else
    for _fz in /usr/local/share/fzf/key-bindings.zsh /usr/share/fzf/key-bindings.zsh; do
        [ -f "$_fz" ] && source "$_fz"
    done
    for _fz in /usr/local/share/fzf/completion.zsh /usr/share/fzf/completion.zsh; do
        [ -f "$_fz" ] && source "$_fz"
    done
    unset _fz
fi
# Atuin owns Ctrl-R; fzf keeps Ctrl-T + Alt-C.
if command -v atuin >/dev/null 2>&1; then eval "$(atuin init zsh --disable-up-arrow)"; fi
if command -v direnv >/dev/null 2>&1; then eval "$(direnv hook zsh)"; fi

# yazi: `y` cds into the directory you exit in
y() {
  local tmp="$(mktemp "${TMPDIR:-/tmp}/yazi-cwd.XXXXXX")"
  command yazi "$@" --cwd-file="$tmp"
  local cwd="$(cat -- "$tmp" 2>/dev/null)"
  rm -f -- "$tmp"
  [ -n "$cwd" ] && [ "$cwd" != "$PWD" ] && cd -- "$cwd"
}

# ~/.local/bin carries the repo helpers (freebsd-wallpaper-picker, …).
case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) export PATH="$HOME/.local/bin:$PATH";; esac

# Desktop info on login shells only: fastfetch prints the FreeBSD  logo on
# this OS (auto-detected). Interactive subshells skip it for speed.
[[ -o login ]] && command -v fastfetch >/dev/null 2>&1 && fastfetch
