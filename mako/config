# ── mako config (Void port) — colors come from matugen ──
# ~/.config/mako/colors is generated from matugen/templates/mako-colors
# on every wallpaper switch (matugen [templates.mako]); `makoctl reload`
# re-reads it live (see sway-wall.sh step 5).
include=~/.config/mako/colors

font=JetBrainsMono Nerd Font 10
width=360
height=150
margin=12
padding=12
border-size=1
border-radius=12
icons=1
max-icon-size=48
markup=1
actions=1
history=1
max-visible=4
sort=-time
layer=overlay
anchor=top-right
default-timeout=6000

[urgency=critical]
ignore-timeout=1
default-timeout=0
border-size=2

[mode=do-not-disturb]
invisible=1
